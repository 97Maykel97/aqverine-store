generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_role")
}

enum ProductStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("product_status")
}

enum OrderStatus {
  PENDING_PAYMENT @map("pending_payment")
  PAID            @map("paid")
  PROCESSING      @map("processing")
  COMPLETED       @map("completed")
  CANCELLED       @map("cancelled")
  REFUNDED        @map("refunded")

  @@map("order_status")
}

enum PaymentStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")
  REFUNDED  @map("refunded")

  @@map("payment_status")
}

enum WebhookEventStatus {
  RECEIVED  @map("received")
  PROCESSED @map("processed")
  IGNORED   @map("ignored")
  FAILED    @map("failed")

  @@map("webhook_event_status")
}

model User {
  id        String   @id @db.Uuid
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile?
  cart    Cart?
  orders  Order[]

  @@map("users")
}

model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  fullName  String?  @map("full_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  name             String
  description      String
  category         String
  composition      String?
  careInstructions String?       @map("care_instructions")
  priceMinor       Int           @map("price_minor")
  currency         String        @default("USD") @db.VarChar(3)
  status           ProductStatus @default(DRAFT)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([status, category, createdAt(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique
  color      String
  size       String
  priceMinor Int?     @map("price_minor")
  stock      Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  color      String?
  localPath  String?  @map("local_path")
  storageKey String?  @unique @map("storage_key")
  altText    String   @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, localPath])
  @@index([productId, color, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  mergeEvents CartMergeEvent[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model CartMergeEvent {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  mergeKey  String   @map("merge_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, mergeKey])
  @@index([createdAt])
  @@map("cart_merge_events")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  number        Int         @unique @default(autoincrement())
  userId        String      @map("user_id") @db.Uuid
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotalMinor Int         @map("subtotal_minor")
  totalMinor    Int         @map("total_minor")
  currency      String      @default("USD") @db.VarChar(3)
  contactName   String      @map("contact_name")
  contactPhone  String      @map("contact_phone")
  contactEmail  String      @map("contact_email")
  comment       String?
  consentAt     DateTime    @map("consent_at") @db.Timestamptz(6)
  paidAt        DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  productName    String  @map("product_name")
  sku            String?
  color          String
  size           String
  unitPriceMinor Int     @map("unit_price_minor")
  quantity       Int
  lineTotalMinor Int     @map("line_total_minor")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  idempotencyKey    String        @unique @map("idempotency_key")
  amountMinor       Int           @map("amount_minor")
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt(sort: Desc)])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  paymentId       String?            @map("payment_id") @db.Uuid
  provider        String
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  status          WebhookEventStatus @default(RECEIVED)
  payloadHash     String?            @map("payload_hash")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt(sort: Desc)])
  @@map("payment_webhook_events")
}
